{
  "name": "openflycut",
  "version": "0.1.0",
  "description": "Open-source, cross-platform clipboard history manager inspired by Flycut",
  "homepage": "https://github.com/angeloLed/openflycut",
  "main": "./out/main/index.js",
  "author": {
    "name": "OpenFlyCut Contributors",
    "email": "openflycut@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "generate-icons": "node scripts/generate-icons.mjs",
    "smoke-test": "node scripts/smoke-test.mjs",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "node scripts/release.mjs",
    "release:win": "node scripts/release.mjs win",
    "release:mac": "node scripts/release.mjs mac",
    "release:linux": "node scripts/release.mjs linux"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "koffi": "^3.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "jimp": "^1.6.0",
    "playwright-core": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
